{
  "manifest_version": 3,
  "name": "公众号 Markdown → X 文章",
  "version": "2.0.0",
  "description": "在公众号文章页一键下载 Markdown（图片存到同名文件夹），在 X 文章编辑器里导入本地 Markdown，一步生成 X 草稿。",
  "permissions": ["downloads"],
  "host_permissions": [
    "https://mp.weixin.qq.com/*",
    "https://mmbiz.qpic.cn/*",
    "https://mmbiz.qlogo.cn/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "公众号页：下载 Markdown ｜ X 页：导入 Markdown",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://mp.weixin.qq.com/s*"],
      "js": ["ui.js", "wechat.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["lib/marked.min.js", "ui.js", "sanitize.js", "x.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["x-main.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
